---
import { Icon } from "astro-icon/components";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { url } from "@utils/url-utils";
import { libraryMeta, type Book } from "../../data/books";
import { resolveBooks } from "../../utils/library";

export function getStaticPaths() {
	return resolveBooks().map((book) => ({
		params: { id: book.id },
		props: { book },
	}));
}

interface Props {
	book: Book;
}

const { book } = Astro.props;
const coverUrl = book.coverUrl ? url(book.coverUrl) : undefined;
const fileUrl = url(book.fileUrl);
const libraryUrl = url("/library/");
const folderBreadcrumbs = book.folderSegments.map((name, index) => {
	const folderPath = book.folderSegments.slice(0, index + 1).join("/");
	return {
		name,
		href: url(`/library/?folder=${encodeURIComponent(folderPath)}`),
	};
});
const detailRows = [
	[libraryMeta.author, book.author],
	...(book.source === "network" ? [[libraryMeta.source, libraryMeta.networkSource]] : []),
	...(book.series ? [[libraryMeta.series, book.series]] : []),
	...(book.volume === undefined
		? []
		: [
				[
					libraryMeta.volume,
					libraryMeta.volumePattern.replace("{volume}", String(book.volume)),
				],
			]),
	[libraryMeta.category, book.category],
	[libraryMeta.format, book.format],
	...(book.fileSizeLabel ? [[libraryMeta.fileSize, book.fileSizeLabel]] : []),
	[libraryMeta.readingStatus, libraryMeta.readingStatusLabels[book.readingStatus]],
	[libraryMeta.added, book.added],
	[libraryMeta.rating, book.rating === undefined ? "—" : `${book.rating}/5`],
] satisfies Array<[string, string]>;
---

<MainGridLayout
	title={book.title}
	description={book.description}
	ogImage={coverUrl}
	setOGTypeArticle={true}
>
	<article class="book-detail">
		<a class="book-detail__back" href={libraryUrl}>
			<Icon name="material-symbols:arrow-back-rounded" aria-hidden="true" />
			{libraryMeta.back}
		</a>
		{folderBreadcrumbs.length > 0 && (
			<nav class="book-detail__breadcrumbs" aria-label={libraryMeta.folderNavigation}>
				<a href={libraryUrl}>{libraryMeta.allBooks}</a>
				{folderBreadcrumbs.map((folder) => (
					<span>
						<Icon name="material-symbols:chevron-right-rounded" aria-hidden="true" />
						<a href={folder.href}>{folder.name}</a>
					</span>
				))}
			</nav>
		)}

		<div class="book-detail__main">
			<div class="book-detail__cover">
				{coverUrl ? (
					<img
						src={coverUrl}
						alt={`${book.title}${libraryMeta.coverSuffix}`}
						decoding="async"
					/>
				) : (
					<div class="book-detail__fallback">
						<Icon name="material-symbols:menu-book-outline-rounded" aria-hidden="true" />
						<strong>{book.title}</strong>
						<span>{libraryMeta.noCover}</span>
					</div>
				)}
			</div>

			<div class="book-detail__content">
				<div class="book-detail__heading">
					<span>{book.format}</span>
					<span>{libraryMeta.statusLabels[book.status]}</span>
				</div>
				<h1>{book.title}</h1>
				<p class="book-detail__description">{book.description}</p>

				<section class="book-detail__review" aria-labelledby="personal-review-title">
					<h2 id="personal-review-title">{libraryMeta.personalReview}</h2>
					<p class:list={{ "book-detail__review-empty": !book.personalReview }}>
						{book.personalReview || libraryMeta.emptyPersonalReview}
					</p>
				</section>

				<dl class="book-detail__metadata" aria-label={libraryMeta.metadataLabel}>
					{detailRows.map(([label, value]) => (
						<div>
							<dt>{label}</dt>
							<dd>{value}</dd>
						</div>
					))}
				</dl>

				{book.tags.length > 0 && (
					<div class="book-detail__tags">
						{book.tags.map((tag) => <span>#{tag}</span>)}
					</div>
				)}

				<a class="book-detail__download" href={fileUrl} download>
					<Icon name="material-symbols:download-rounded" aria-hidden="true" />
					{libraryMeta.download} {book.format}
				</a>
			</div>
		</div>
	</article>
</MainGridLayout>

<style lang="stylus">
.book-detail
	padding: var(--m3e-space-6)
	border-radius: var(--shape-corner-l)
	background: var(--card-bg)
	color: var(--on-surface)

	&__back
		display: inline-flex
		align-items: center
		gap: var(--m3e-space-2)
		margin-bottom: var(--m3e-space-3)
		color: var(--primary)
		font: var(--m3e-type-label-large)
		text-decoration: none

		> :global(svg)
			width: 1.25rem
			height: 1.25rem

	&__breadcrumbs
		display: flex
		align-items: center
		flex-wrap: wrap
		gap: var(--m3e-space-1)
		margin: 0 0 var(--m3e-space-5)
		color: var(--on-surface-variant)
		font: var(--m3e-type-label-medium)

		a,
		span
			display: inline-flex
			align-items: center
			gap: var(--m3e-space-1)

		a
			color: var(--primary)
			text-decoration: none

		:global(svg)
			width: 1rem
			height: 1rem

	&__main
		display: grid
		grid-template-columns: minmax(12rem, 18rem) minmax(0, 1fr)
		gap: var(--m3e-space-6)

	&__cover
		min-height: 24rem
		overflow: hidden
		border-radius: var(--shape-corner-l)
		background: var(--surface-container-high)

		> img
			display: block
			width: 100%
			height: 100%
			object-fit: cover

	&__fallback
		display: flex
		align-items: center
		justify-content: center
		flex-direction: column
		gap: var(--m3e-space-3)
		height: 100%
		padding: var(--m3e-space-5)
		background: linear-gradient(145deg, var(--primary-container), var(--tertiary-container))
		color: var(--on-primary-container)
		text-align: center

		> :global(svg)
			width: 3rem
			height: 3rem

		strong
			font: var(--m3e-type-title-large)
			font-weight: 700

		span
			font: var(--m3e-type-label-medium)

	&__content
		display: flex
		min-width: 0
		flex-direction: column

		h1
			margin: var(--m3e-space-3) 0 0
			font: var(--m3e-type-headline-medium)
			font-weight: 700
			overflow-wrap: anywhere

	&__heading,
	&__tags
		display: flex
		flex-wrap: wrap
		gap: var(--m3e-space-2)

	&__heading span
		padding: var(--m3e-space-1) var(--m3e-space-3)
		border-radius: var(--shape-corner-full)
		background: var(--tertiary-container)
		color: var(--on-tertiary-container)
		font: var(--m3e-type-label-medium)

	&__description
		margin: var(--m3e-space-4) 0 0
		color: var(--on-surface-variant)
		font: var(--m3e-type-body-large)
		line-height: 1.7

	&__review
		margin-top: var(--m3e-space-5)
		padding: var(--m3e-space-4)
		border-radius: var(--shape-corner-m)
		background: var(--surface-container)

		h2
			margin: 0
			font: var(--m3e-type-title-medium)
			font-weight: 700

		p
			margin: var(--m3e-space-2) 0 0
			font: var(--m3e-type-body-medium)
			line-height: 1.7
			white-space: pre-wrap

	&__review-empty
		color: var(--on-surface-variant)

	&__metadata
		display: grid
		grid-template-columns: repeat(2, minmax(0, 1fr))
		gap: var(--m3e-space-3)
		margin: var(--m3e-space-5) 0 0

		> div
			padding: var(--m3e-space-3)
			border-radius: var(--shape-corner-m)
			background: var(--surface-container)

		dt
			color: var(--on-surface-variant)
			font: var(--m3e-type-label-medium)

		dd
			margin: var(--m3e-space-1) 0 0
			font: var(--m3e-type-body-medium)
			overflow-wrap: anywhere

	&__tags
		margin-top: var(--m3e-space-4)
		color: var(--primary)
		font: var(--m3e-type-label-medium)

	&__download
		display: inline-flex
		align-items: center
		justify-content: center
		align-self: flex-start
		gap: var(--m3e-space-2)
		min-height: 3rem
		margin-top: auto
		padding: 0 var(--m3e-space-5)
		border-radius: var(--shape-corner-full)
		background: var(--primary)
		color: var(--on-primary)
		font: var(--m3e-type-label-large)
		text-decoration: none

		> :global(svg)
			width: 1.25rem
			height: 1.25rem

@media (max-width: 48rem)
	.book-detail
		padding: var(--m3e-space-4)

		&__main
			grid-template-columns: 1fr

		&__cover
			width: min(100%, 18rem)
			min-height: 24rem

		&__metadata
			grid-template-columns: 1fr

		&__download
			width: 100%
			margin-top: var(--m3e-space-5)
</style>
